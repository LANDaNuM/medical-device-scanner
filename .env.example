# Plik konfiguracyjny dla kluczy API
# Skopiuj ten plik do .env i wypełnij swoimi kluczami API

# VirusTotal API Key
# Uzyskaj darmowy klucz na: https://www.virustotal.com/gui/join-us
# Format: VIRUSTOTAL_API_KEY=twoj_klucz_tutaj
VIRUSTOTAL_API_KEY=

# Shodan API Key (opcjonalne)
# Uzyskaj darmowy klucz na: https://account.shodan.io/register
# Format: SHODAN_API_KEY=twoj_klucz_tutaj
SHODAN_API_KEY=

# NVD API Key (opcjonalne, zwiększa limity dla CVE lookup)
# Uzyskaj darmowy klucz na: https://nvd.nist.gov/developers/request-an-api-key
# Format: NVD_API_KEY=twoj_klucz_tutaj
NVD_API_KEY=

# Vulners API Key (opcjonalne)
# Uzyskaj darmowy klucz na: https://vulners.com/register
# Format: VULNERS_API_KEY=twoj_klucz_tutaj
VULNERS_API_KEY=

# AbuseIPDB API Key (opcjonalne, dla threat intelligence)
# Uzyskaj darmowy klucz:
# 1. Zarejestruj się: https://www.abuseipdb.com/register
# 2. Po zalogowaniu: Settings → API Key (lub https://www.abuseipdb.com/account/api)
# 3. Limity: 1000 req/dzień za darmo
# Format: ABUSEIPDB_API_KEY=twoj_klucz_tutaj
ABUSEIPDB_API_KEY=

# Email Notifications (opcjonalne, dla powiadomień email)
# 
# Przykład dla Gmail:
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=twoj_email@gmail.com
# SMTP_PASSWORD=twoje_haslo_aplikacji  # Użyj "App Password" dla Gmail
# EMAIL_FROM=twoj_email@gmail.com
# 
# Przykład dla Outlook:
# SMTP_SERVER=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=twoj_email@outlook.com
# SMTP_PASSWORD=twoje_haslo
# EMAIL_FROM=twoj_email@outlook.com
#
# Przykład dla ProtonMail (WYMAGA ProtonMail Bridge):
# 1. Zainstaluj ProtonMail Bridge: https://proton.me/mail/bridge
# 2. Uruchom Bridge i zaloguj się
# 3. Bridge utworzy lokalny SMTP na 127.0.0.1:1025
# SMTP_SERVER=127.0.0.1
# SMTP_PORT=1025
# SMTP_USER=twoj_email@protonmail.com
# SMTP_PASSWORD=twoje_haslo_protonmail  # To samo co w Bridge
# EMAIL_FROM=twoj_email@protonmail.com
# UWAGA: ProtonMail Bridge musi być uruchomiony podczas wysyłania!
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
