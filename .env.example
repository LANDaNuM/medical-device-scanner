# API keys configuration template
# Copy this file to .env and fill in your API keys

# VirusTotal API Key
# Get a free key at: https://www.virustotal.com/gui/join-us
# Format: VIRUSTOTAL_API_KEY=your_key_here
VIRUSTOTAL_API_KEY=

# Shodan API Key (optional)
# Get a free key at: https://account.shodan.io/register
# Format: SHODAN_API_KEY=your_key_here
SHODAN_API_KEY=

# NVD API Key (optional, increases rate limits for CVE lookup)
# Get a free key at: https://nvd.nist.gov/developers/request-an-api-key
# Format: NVD_API_KEY=your_key_here
NVD_API_KEY=

# Vulners API Key (optional)
# Get a free key at: https://vulners.com/register
# Format: VULNERS_API_KEY=your_key_here
VULNERS_API_KEY=

# AbuseIPDB API Key (optional, for threat intelligence)
# Get a free key:
# 1. Register: https://www.abuseipdb.com/register
# 2. After login: Settings → API Key (or https://www.abuseipdb.com/account/api)
# 3. Limits: 1000 req/day for free
# Format: ABUSEIPDB_API_KEY=your_key_here
ABUSEIPDB_API_KEY=

# Email Notifications (optional, for email alerts)
#
# Example for Gmail:
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password  # Use "App Password" for Gmail
# EMAIL_FROM=your_email@gmail.com
#
# Example for Outlook:
# SMTP_SERVER=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=your_email@outlook.com
# SMTP_PASSWORD=your_password
# EMAIL_FROM=your_email@outlook.com
#
# Example for ProtonMail (REQUIRES ProtonMail Bridge):
# 1. Install ProtonMail Bridge: https://proton.me/mail/bridge
# 2. Run Bridge and sign in
# 3. Bridge creates local SMTP on 127.0.0.1:1025
# SMTP_SERVER=127.0.0.1
# SMTP_PORT=1025
# SMTP_USER=your_email@protonmail.com
# SMTP_PASSWORD=your_protonmail_password  # Same as in Bridge
# EMAIL_FROM=your_email@protonmail.com
# NOTE: ProtonMail Bridge must be running when sending mail!
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
